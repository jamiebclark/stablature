# Read by docker compose (compose loads .env automatically).
# Copy to .env and fill in before `docker compose up`.
#
# This is separate from .env.local, which is only for `npm run dev` on the host.

POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5440

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# The address the app is served from.
APP_URL=http://localhost:3000
APP_PORT=3000

# Extra origins allowed to sign in, comma-separated. Add whatever address your
# phone uses, or sign-in will be rejected from it.
# TRUSTED_ORIGINS=http://unraid.local:3000,http://192.168.1.20:3000

# Image version from ghcr.io/jamiebclark/stablature. Leave unset for latest, or
# pin one (e.g. 1.11.2) so an update only happens when you change this.
# STABLATURE_VERSION=1.11.2
