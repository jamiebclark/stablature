# Read by docker compose (compose loads .env automatically).
# Copy to .env and fill in before `docker compose up`.
#
# This is separate from .env.local, which is only for `npm run dev` on the host.

POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5440

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Must be the address the PHONE will use, not localhost, or the session cookie
# will not stick when you load it over the LAN.
APP_URL=http://localhost:3000
APP_PORT=3000
