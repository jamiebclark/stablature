# Deliberately NOT named DATABASE_URL: ambient shell vars take precedence over
# env files, and a generic name collides with every other project on this box.
# Postgres. The docker-compose service is reachable on this URL from the host.
STABLATURE_DATABASE_URL=postgres://stablature:stablature@localhost:5440/stablature

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000

# Extra origins allowed to sign in, comma-separated. Needed when you reach the
# app by any name other than BETTER_AUTH_URL -- e.g. from your phone on the LAN.
# STABLATURE_TRUSTED_ORIGINS=http://unraid.local:3000,http://192.168.1.20:3000
